{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Learning",
  "type": "object",
  "required": [
    "id",
    "created_at",
    "status",
    "source_run_id",
    "source_task",
    "category",
    "applies_when",
    "rule",
    "rationale",
    "evidence",
    "tags",
    "confidence"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "pending",
        "rejected",
        "superseded"
      ]
    },
    "source_run_id": {
      "type": "string"
    },
    "source_task": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "architecture_pattern",
        "bug_prevention",
        "testing_pattern",
        "validation_command",
        "integration_boundary",
        "security_constraint",
        "performance_constraint",
        "domain_rule",
        "workflow_improvement",
        "prompt_improvement"
      ]
    },
    "applies_when": {
      "type": "string"
    },
    "rule": {
      "type": "string"
    },
    "rationale": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "artifact",
          "excerpt"
        ],
        "properties": {
          "artifact": {
            "type": "string"
          },
          "excerpt": {
            "type": "string"
          }
        }
      }
    },
    "avoid_when": {
      "type": "string"
    },
    "related_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "usage_count": {
      "type": "integer",
      "minimum": 0
    },
    "success_count": {
      "type": "integer",
      "minimum": 0
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "superseded_by": {
      "type": "string"
    }
  }
}
